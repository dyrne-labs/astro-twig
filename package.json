{
  "name": "astro-twig",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "description": "Render Twig templates as Astro components, at build time",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-renderer",
    "twig",
    "twig.js"
  ],
  "homepage": "https://github.com/dyrne-labs/astro-twig",
  "bugs": "https://github.com/dyrne-labs/astro-twig/issues",
  "repository": "https://github.com/dyrne-labs/astro-twig.git",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "exports": {
    ".": {
      "types": "./types/integration.d.ts",
      "default": "./src/integration.mjs"
    },
    "./server": "./src/server.mjs",
    "./types": "./types/twig.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint ./src ./tests",
    "lint:fix": "eslint ./src ./tests --fix",
    "test": "node --test 'tests/*.test.mjs'",
    "test:ci": "node --test 'tests/*.test.mjs'",
    "test:example": "npm --prefix examples/basic run build"
  },
  "dependencies": {
    "twig": "github:dyrne-labs/twig.js#master"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "astro": "^7.2.0",
    "eslint": "^10.0.3",
    "eslint-plugin-import-newlines": "^2.0.0",
    "globals": "^17.4.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "vite": ">=5.0.0"
  }
}
